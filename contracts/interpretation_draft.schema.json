{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerproof.local/contracts/interpretation_draft.schema.json",
  "title": "InterpretationDraft",
  "description": "Untrusted structured output produced by a lightweight model before deterministic resolution. It never contains SQL or financial results.",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "metric_phrase", "date_phrase", "filter_mentions", "group_phrase", "comparison_phrase", "ambiguities", "unsupported_concepts"],
  "properties": {
    "intent": {"enum": ["aggregate", "lookup", "list", "compare", "balance", "account_count", "unknown"]},
    "metric_phrase": {"type": ["string", "null"], "maxLength": 120},
    "date_phrase": {"type": ["string", "null"], "maxLength": 120},
    "filter_mentions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "raw_value"],
        "properties": {
          "kind": {"enum": ["bank", "account", "entity", "program", "transaction_type", "description", "reference", "utr", "transaction_id", "amount"]},
          "raw_value": {"type": "string", "maxLength": 256}
        }
      }
    },
    "group_phrase": {"type": ["string", "null"], "maxLength": 120},
    "comparison_phrase": {"type": ["string", "null"], "maxLength": 120},
    "ambiguities": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 300}},
    "unsupported_concepts": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 200}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerproof.local/contracts/query_state.schema.json",
  "title": "QueryState",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversation_id", "context_version", "dataset_version", "data_as_of", "last_user_message_id", "last_successful_query_id", "active_plan", "active_scope_receipt_id", "updated_at"],
  "properties": {
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "context_version": {"type": "integer", "minimum": 0},
    "dataset_version": {"const": "tiby-finance-fixture-v2.0.0"},
    "data_as_of": {"const": "2026-09-03T23:59:59.999999+05:30"},
    "last_user_message_id": {"type": ["string", "null"], "maxLength": 128},
    "last_successful_query_id": {"type": ["string", "null"], "maxLength": 128},
    "active_plan": {"oneOf": [{"type": "null"}, {"$ref": "query_plan.schema.json"}]},
    "active_scope_receipt_id": {"type": ["string", "null"], "description": "Receipt whose immutable predicate set is referenced by phrases such as 'those transactions'."},
    "pending_clarification": {
      "type": ["object", "null"],
      "properties": {
        "message_id": {"type": "string"},
        "question": {"type": "string"},
        "options": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false,
      "required": ["message_id", "question", "options"]
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}

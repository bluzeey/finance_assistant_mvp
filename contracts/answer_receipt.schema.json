{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerproof.local/contracts/answer_receipt.schema.json",
  "title": "AnswerReceipt",
  "description": "Immutable evidence envelope returned for every assistant response, including non-answer states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "query_id", "conversation_id", "context_version", "status", "answer",
    "dataset", "interpretation", "computation", "lineage", "privacy", "warnings", "actions", "timings", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "query_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "context_version": {"type": "integer", "minimum": 0},
    "status": {"enum": ["verified", "qualified", "needs_clarification", "unsupported", "no_data", "validation_failed"]},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "summary", "display_value", "unit"],
      "properties": {
        "headline": {"type": "string", "maxLength": 300},
        "summary": {"type": "string", "maxLength": 2000},
        "display_value": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"], "enum": ["INR", "records", "accounts", null]}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "currency", "timezone", "data_as_of", "source_tables"],
      "properties": {
        "version": {"const": "tiby-finance-fixture-v2.0.0"},
        "currency": {"const": "INR"},
        "timezone": {"const": "Asia/Kolkata"},
        "data_as_of": {"const": "2026-09-03T23:59:59.999999+05:30"},
        "source_tables": {"type": "array", "items": {"enum": ["bank", "account", "transaction"]}, "uniqueItems": true}
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_label", "date_label", "filters", "group_by", "comparison_label", "query_plan_hash"],
      "properties": {
        "metric_label": {"type": ["string", "null"]},
        "date_label": {"type": ["string", "null"]},
        "filters": {"type": "array", "items": {"type": "object"}},
        "group_by": {"type": "array", "items": {"type": "string"}},
        "comparison_label": {"type": ["string", "null"]},
        "query_plan_hash": {"type": ["string", "null"]}
      }
    },
    "computation": {"oneOf": [{"type": "null"}, {"$ref": "computed_facts.schema.json"}]},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_row_count", "source_account_count", "record_endpoint", "export_endpoint", "sanitized_sql", "parameter_summary", "source_hash"],
      "properties": {
        "source_row_count": {"type": "integer", "minimum": 0},
        "source_account_count": {"type": ["integer", "null"], "minimum": 0},
        "record_endpoint": {"type": ["string", "null"]},
        "export_endpoint": {"type": ["string", "null"]},
        "sanitized_sql": {"type": ["string", "null"], "description": "Allow-listed statement with placeholders; never includes raw sensitive parameters."},
        "parameter_summary": {"type": "object"},
        "source_hash": {"type": ["string", "null"]}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_numbers_masked", "utr_numbers_masked", "description_redaction_applied", "raw_sensitive_values_sent_to_model"],
      "properties": {
        "account_numbers_masked": {"type": "boolean"},
        "utr_numbers_masked": {"type": "boolean"},
        "description_redaction_applied": {"type": "boolean"},
        "raw_sensitive_values_sent_to_model": {"const": false}
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["info", "warning", "blocking"]},
          "message": {"type": "string"}
        }
      }
    },
    "clarification": {"type": ["object", "null"]},
    "unsupported": {"type": ["object", "null"]},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "enabled"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "kind": {"enum": ["view_records", "export_csv", "export_xlsx", "copy_answer", "retry", "apply_clarification"]},
          "enabled": {"type": "boolean"},
          "reason_disabled": {"type": ["string", "null"]}
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_ms", "model_ms", "query_ms", "validation_ms"],
      "properties": {
        "total_ms": {"type": "integer", "minimum": 0},
        "model_ms": {"type": "integer", "minimum": 0},
        "query_ms": {"type": "integer", "minimum": 0},
        "validation_ms": {"type": "integer", "minimum": 0}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}

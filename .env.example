# Source database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=finance_assistant
MYSQL_USER=finance
MYSQL_PASSWORD=finance
MYSQL_ROOT_PASSWORD=root-finance
MYSQL_SESSION_TIMEZONE=+05:30

# Dataset semantics
DATASET_VERSION=tiby-finance-fixture-v2.0.0
DATASET_TIMEZONE=Asia/Kolkata
DATA_AS_OF=2026-09-03T23:59:59.999999+05:30
CURRENCY=INR
UTR_STORAGE_MODE=encrypted_or_tokenized
UTR_SEARCH_ENABLED=false
ACCOUNT_NUMBER_SEARCH_ENABLED=false

# Application
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
REDIS_URL=redis://127.0.0.1:6379/0
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=15
QUERY_TIMEOUT_MS=5000
MAX_SOURCE_PREVIEW_ROWS=100
MAX_EXPORT_ROWS=100000

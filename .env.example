# LedgerProof local development defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledgerproof
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=ledgerproof-local-development-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LEDGERPROOF_ENABLE_EVALUATION=false
LEDGERPROOF_PROMPT_VERSION=interpretation-draft-sarvam-v1
LEDGERPROOF_MODEL_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_API_SUBSCRIPTION_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL_ID=sarvam-105b-conversations
SARVAM_TIMEOUT_SECONDS=10.0
SARVAM_TEMPERATURE=0.1
SARVAM_MAX_TOKENS=800
SARVAM_REASONING_EFFORT=low
SARVAM_SEED=20260904
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_SAMPLE_RECEIPT=false
